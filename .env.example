# =====================================================================
# GOLD (XAU/USD) & FOREX INSTITUTIONAL TRADING BOT CONFIGURATION
# =====================================================================

# Account & Risk Sizing
ACCOUNT_BALANCE=10000.0
RISK_PERCENT=1.0
MAX_DAILY_RISK_PERCENT=3.0
DEFAULT_RISK_REWARD=2.0

# Target Asset
PRIMARY_SYMBOL=XAUUSD

# Confluence Quality Filter (0-100%)
# Recommended: 85 to 90 for Grade A+ setups only.
MIN_CONFLUENCE_SCORE=85

# ForexFactory News & Macroeconomic Settings
NEWS_FILTER_ENABLED=True
NEWS_PRE_EVENT_FREEZE_MINS=30
NEWS_POST_EVENT_WAIT_MINS=10
NEWS_CATALYST_WINDOW_MINS=120

# Email Alerts (SMTP)
# To use Gmail: Set EMAIL_ENABLED=True and generate a 16-character 'App Password' from Google Account Security.
EMAIL_ENABLED=False
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
NOTIFICATION_RECEIVER_EMAIL=your_email@gmail.com

# Telegram Instant Alerts (Phone Notifications)
TELEGRAM_ENABLED=True
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Personalization & Market Outlook
USER_NAME=Ahmed
DAILY_OUTLOOK_EMAIL_ENABLED=True

# TradingView Webhook Bridge
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
WEBHOOK_SECRET_TOKEN=GOLD_SNIPER_SECRET_KEY_9988
